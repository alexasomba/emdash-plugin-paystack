        },
        "providerPayload": {
          "secret": "fixture-secret"
        },
        "signature": "fixture-signature",
        "credential": "fixture-credential"
      },
      "appliesTo": [
        "customers",
        "payments",
        "payment-detail",
        "webhook-events",
        "ordinary-logs"
      ],
      "expected": "All input keys absent; only valid allowlisted fields independently constructed from trusted typed data may appear."

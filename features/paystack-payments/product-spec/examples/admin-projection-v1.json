    {
      "id": "no-raw-error-or-nested-fallback",
      "input": {
        "providerError": "payer@example.test fixture-secret",
        "history": [
          {
            "state": "payer@example.test",
            "rawPayload": {
              "email": "payer@example.test"
            }
          }
        ],
        "maskedEmail": "payer@example.test"
      },
      "expected": "Static safe error; unknown history state normalized to unknown; nested rawPayload absent; maskedEmail recomputed from validated source or omitted, never trusted/copied."
    },
    {
      "id": "feed-is-distinct",
      "inputContract": "API-result-feed",

      "id": "reject-pii-and-payload-projection",
      "input": {
        "email": "payer@example.test",
        "name": "Fictional Payer",
        "phone": "+000000000",
        "address": "Fictional street",
        "subject": "payer@example.test",
        "businessReference": "order-payer@example.test",

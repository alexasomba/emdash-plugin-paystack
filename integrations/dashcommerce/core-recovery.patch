+      k === 'settings:paystackWebhookSecret' ? 'test-secret' : null },
+    storage: { orders: { query: async () => ({ items: [], hasMore: false }) }, stripe_events: {
+      put: async (id: string, row: { id: string; stripeEventId: string; processingState?: string }) => {
+        const old = events.get(row.stripeEventId);
+        if (old && old.id !== id) throw Object.assign(new Error('duplicate'), { code: 'UNIQUE' });
+        events.set(row.stripeEventId, row);
+      },
+      query: async ({where}: {where: {stripeEventId: string}}) => { const row = events.get(where.stripeEventId); return {items: row ? [{id: row.id, data: row}] : [], hasMore: false}; },

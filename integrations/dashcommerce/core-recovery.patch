new file mode 100644
index 0000000..ebab23f
--- /dev/null
+++ b/packages/core/src/cart/checkout-reservation.ts
@@ -0,0 +1,60 @@
+/** One durable checkout identity per session while a non-Stripe payment is unresolved. */
+import type { PluginContext } from 'emdash';
+import type { CartState } from '../types';
+import { randomId } from '../util/ids';
+
+interface Reservation { version: 1; state: 'active' | 'completed'; orderDraftId: string; fingerprint: string; }
+const isReservation = (v: unknown): v is Reservation => {
+  if (!v || typeof v !== 'object' || Array.isArray(v)) return false;
+  const r = v as Record<string, unknown>;
+  return r.version === 1 && (r.state === 'active' || r.state === 'completed') &&
+    typeof r.orderDraftId === 'string' && /^[a-f0-9]{32}$/u.test(r.orderDraftId) &&
+    typeof r.fingerprint === 'string' && /^[a-f0-9]{64}$/u.test(r.fingerprint);
+};
+async function hash(value: string): Promise<string> {
+  const bytes = new Uint8Array(await crypto.subtle.digest('SHA-256', new TextEncoder().encode(value)));
+  return [...bytes].map((v) => v.toString(16).padStart(2, '0')).join('');
+}
+function canonical(value: unknown): string {
+  if (value === null || typeof value !== 'object') return JSON.stringify(value) ?? 'null';
+  if (Array.isArray(value)) return `[${value.map(canonical).join(',')}]`;
+  const v = value as Record<string, unknown>;
+  return `{${Object.keys(v).filter((key) => v[key] !== undefined).sort().map((key) => `${JSON.stringify(key)}:${canonical(v[key])}`).join(',')}}`;
+}
+async function key(sessionId: string): Promise<string> { return `checkout-reservation:${await hash(sessionId)}`; }
+async function fingerprint(cart: CartState, providerId: string): Promise<string> {
+  const { createdAt: _created, updatedAt: _updated, ...stable } = cart;
+  return hash(canonical({ providerId, cart: stable }));
+}
+export async function activeCheckoutDraft(ctx: PluginContext, sessionId: string): Promise<string | null> {
+  const row = await ctx.kv.getVersioned(await key(sessionId));
+  if (!row) return null;
+  if (!isReservation(row.value)) throw new Error('Checkout reservation is invalid');
+  return row.value.state === 'active' ? row.value.orderDraftId : null;
+}
+export async function reserveCheckout(ctx: PluginContext, cart: CartState, providerId: string): Promise<string> {
+  if (!cart.sessionId || !providerId || typeof ctx.kv.getVersioned !== 'function' || typeof ctx.kv.compareAndSet !== 'function') {
+    throw new Error('Checkout reservation unavailable');
+  }
+  const storageKey = await key(cart.sessionId), digest = await fingerprint(cart, providerId);
+  const existing = await ctx.kv.getVersioned(storageKey);
+  if (existing && !isReservation(existing.value)) throw new Error('Checkout reservation is invalid');
+  if (existing && isReservation(existing.value) && existing.value.state === 'active') {
+    if (existing.value.fingerprint !== digest) throw new Error('A previous checkout is still unresolved');
+    return existing.value.orderDraftId;
+  }
+  const record: Reservation = { version: 1, state: 'active', orderDraftId: randomId(), fingerprint: digest };
+  const written = await ctx.kv.compareAndSet(storageKey, existing?.revision ?? null, record);
+  if (written.applied) return record.orderDraftId;
+  const winner = await ctx.kv.getVersioned(storageKey);
+  if (winner && isReservation(winner.value) && winner.value.state === 'active' && winner.value.fingerprint === digest) return winner.value.orderDraftId;
+  throw new Error('Checkout reservation changed; retry safely');
+}
+export async function completeCheckoutReservation(ctx: PluginContext, sessionId: string, draftId: string): Promise<void> {
+  const storageKey = await key(sessionId), row = await ctx.kv.getVersioned(storageKey);
+  if (!row || !isReservation(row.value) || row.value.orderDraftId !== draftId) throw new Error('Checkout reservation mismatch');
+  if (row.value.state === 'completed') return;
+  if (!(await ctx.kv.compareAndSet(storageKey, row.revision, { ...row.value, state: 'completed' })).applied) {
+    throw new Error('Checkout reservation completion conflict');
+  }
+}

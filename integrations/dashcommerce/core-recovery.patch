+/** A single-order CAS fences concurrent workers; abandoned work stays on hold. */
+async function transitionRecoveryState(ctx: PluginContext, id: string, expected: string, next: string, status?: Order["status"]): Promise<Order> {
+	const store = ordersStore(ctx);
+	const row = await store.getVersioned(id);
+	if (!row || row.value.metadata?.recoveryState !== expected) throw new Error("Order recovery is already in progress");
+	const updated = { ...row.value, ...(status ? { status } : {}), metadata: { ...row.value.metadata, recoveryState: next } };
+	const written = await store.compareAndSet(id, row.revision, updated);
+	if (!written.applied) throw new Error("Order recovery is already in progress");
+	return updated;
+}
+
+/** Re-create only missing item rows. Never replay uncertain stock or delivery effects. */
+async function repairPendingOrderItems(ctx: PluginContext, order: Order, cart: CartState): Promise<void> {
+	await transitionRecoveryState(ctx, order.id, "items_pending", "items_writing");
+	const store = orderItemsStore(ctx);
+	const existing = await store.query({ where: { orderId: order.id }, limit: 200 });
+	if (existing.hasMore || cart.items.length > 200) throw new Error("Order item recovery exceeds safe limit");
+	const matches = new Set<number>();
+	for (const row of existing.items) {
+		const item = orderItemFromStorage(row.id, row.data as OrderItem);
+		const candidates = cart.items.map((line, index) => ({ line, index })).filter(({line,index}) =>
+			!matches.has(index) && item.productId === line.productId && item.variantId === line.variantId &&
+			item.quantity === line.quantity && item.name === line.title &&
+			item.unitPrice.amount === line.unitPrice.amount && item.unitPrice.currency === line.unitPrice.currency);
+		if (candidates.length !== 1) throw new Error("Order item recovery requires manual review");
+		matches.add(candidates[0]!.index);
+	}
+	const missing = cart.items.flatMap((line, index) => matches.has(index) ? [] : [{
+		id: `${order.id}_recovery_${index}`,
+		data: orderItemToStorage({ id: `${order.id}_recovery_${index}`, orderId: order.id,
+			productId: line.productId, ...(line.variantId ? { variantId: line.variantId } : {}),
+			sku: "", name: line.title, quantity: line.quantity, unitPrice: line.unitPrice,
+			lineSubtotal: line.lineSubtotal, discountAmount: zero(cart.currency), taxAmount: zero(cart.currency),
+			total: line.lineSubtotal, isDigital: line.isDigital,
+			...(line.vendorId ? { vendorId: line.vendorId } : {}),
+			...(line.subscriptionConfig ? { subscriptionConfig: line.subscriptionConfig } : {}),
+		} as OrderItem) as unknown as OrderItem,
+	}]);
+	try {
+		if (missing.length) await store.putMany(missing);
+	} catch (error) {
+		await transitionRecoveryState(ctx, order.id, "items_writing", "items_pending");
+		throw error;
+	}
+	await transitionRecoveryState(ctx, order.id, "items_writing", "items_repaired_inventory_review_required");
+}
